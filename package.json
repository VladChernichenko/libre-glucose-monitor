{
  "name": "libre-glucose-monitor",
  "version": "1.0.0",
  "description": "Real-time glucose monitoring app using Freestyle Libre sensor and Libre LinkUp API",
  "private": true,
  "dependencies": {
    "@types/node": "^20.19.14",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.2.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "scripts": {
    "set-version": "bash ./scripts/set-version.sh",
    "dev": "npm run set-version && REACT_APP_ENVIRONMENT=local vite",
    "start": "npm run set-version && REACT_APP_ENVIRONMENT=local vite",
    "start:local": "npm run set-version && REACT_APP_ENVIRONMENT=local vite",
    "start:dev": "npm run set-version && REACT_APP_ENVIRONMENT=development vite",
    "start:staging": "npm run set-version && REACT_APP_ENVIRONMENT=staging vite",
    "start:prod": "npm run set-version && REACT_APP_ENVIRONMENT=production vite",
    "start:docker": "npm run set-version && REACT_APP_DOCKER=true vite",
    "build": "(npm run set-version || echo 'Version script failed, continuing...') && REACT_APP_ENVIRONMENT=production vite build",
    "build:local": "npm run set-version && REACT_APP_ENVIRONMENT=local vite build",
    "build:dev": "npm run set-version && REACT_APP_ENVIRONMENT=development vite build",
    "build:staging": "npm run set-version && REACT_APP_ENVIRONMENT=staging vite build",
    "build:prod": "npm run set-version && REACT_APP_ENVIRONMENT=production vite build",
    "build:docker": "(npm run set-version || echo 'Version script failed, continuing...') && REACT_APP_DOCKER=true vite build",
    "build:simple": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pre-commit": "./scripts/pre-commit-check.sh",
    "lint": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "http-proxy-middleware": "^3.0.5",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "nth-check": "^2.0.1"
  }
}
